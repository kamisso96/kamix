---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Preloader from '../components/Preloader.astro';
import FloatingSocialLinks from '../components/FloatingSocialLinks.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import WhyUsSection from '../components/WhyUsSection.astro';
import StatsSection from '../components/StatsSection.astro';
import AboutSection from '../components/AboutSection.astro';
import Footer from '../components/Footer.astro';
import RealisationsSection from '../components/react/RealisationsSection.jsx';
import TestimonialCarousel from '../components/react/TestimonialCarousel.jsx';
import TestimonialFormToggle from '../components/react/TestimonialFormToggle.jsx';
import ContactSection from '../components/react/ContactSection.jsx';
import { realisations } from '../data/realisations';
import { testimonials } from '../data/testimonials';
import { siteConfig } from '../config';
---

<Layout>
  <Preloader />
  <FloatingSocialLinks />
  <Header />

  <main id="main-content">
    <HeroSection />
    <ServicesSection />

    <section class="realisations-section" id="realisations" role="region" aria-label="Nos réalisations">
      <div class="container">
        <div class="section-header" data-aos="fade-up">
          <h2>NOS RÉALISATIONS</h2>
          <p class="section-subtitle">
            Découvrez quelques exemples concrets de nos interventions entre la Chine et l'Afrique.
          </p>
        </div>
        <RealisationsSection client:visible realisations={realisations} />
      </div>
    </section>

    <WhyUsSection />

    <section class="testimonials-section" id="temoignages" role="region" aria-label="Témoignages">
      <div class="container">
        <div class="section-header" data-aos="fade-up">
          <h2>ILS NOUS ONT FAIT CONFIANCE</h2>
          <p class="section-subtitle">
            Découvrez les expériences de nos clients et partenaires.
          </p>
        </div>
        <TestimonialCarousel client:visible testimonials={testimonials} />

        <!-- Formulaire de témoignage masqué derrière un bouton -->
        <TestimonialFormToggle client:visible />
      </div>
    </section>

    <AboutSection />

    <StatsSection />

    <section class="contact-wrapper-section" id="contact" role="region" aria-label="Contact">
      <div class="container">
        <div class="section-header" data-aos="fade-up">
          <h2>CONTACTEZ-NOUS</h2>
          <p class="section-subtitle">
            Notre équipe est à l'écoute pour tous vos projets entre la Chine et l'Afrique.
          </p>
        </div>
        <div class="contact-wrapper">
          <div class="contact-info-card">
            <h3 class="contact-card-title">Haikou KAMIX Consulting Co., Ltd.</h3>

            <div class="contact-card-row">
              <svg class="contact-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"/>
                <path d="M15 5.764v15"/>
                <path d="M9 3.236v15"/>
              </svg>
              <span>Hainan, Haikou - Longhua District, Chine</span>
            </div>

            <div class="contact-card-row">
              <svg class="contact-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <a href="tel:+8617857852690">+86 178 5785 2690</a>
            </div>

            <div class="contact-card-row">
              <svg class="contact-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="20" height="16" x="2" y="4" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
              <a href="mailto:info.kamixconsulting@gmail.com">info.kamixconsulting@gmail.com</a>
            </div>

            <div class="contact-card-row">
              <svg class="contact-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
              <div class="contact-hours">
                <span>Lundi - Vendredi : 8h - 18h</span>
                <span>Samedi : 9h - 13h</span>
                <span>Dimanche : Fermé</span>
              </div>
            </div>

            <div class="contact-social-block">
              <p class="contact-social-title">Suivez-nous sur les réseaux</p>
              <div class="contact-social-links">
                <a href={siteConfig.social.facebook} class="contact-social-link" aria-label="Facebook" target="_blank" rel="noopener noreferrer">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="28" height="28"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                </a>
                <a href={siteConfig.social.instagram} class="contact-social-link" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="28" height="28"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zm0 10.162a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
                </a>
                <a href={siteConfig.social.tiktok} class="contact-social-link" aria-label="TikTok" target="_blank" rel="noopener noreferrer">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="28" height="28"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
                </a>
                <a href={siteConfig.social.whatsapp} class="contact-social-link" aria-label="WhatsApp" target="_blank" rel="noopener noreferrer">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="28" height="28"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
                </a>
                <a href={siteConfig.social.wechat} class="contact-social-link" aria-label="WeChat" target="_blank" rel="noopener noreferrer">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="28" height="28"><path d="M8.691 2.188C3.891 2.188 0 5.476 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 0 1 .213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .163.13.295.29.295a.326.326 0 0 0 .167-.054l1.903-1.114a.864.864 0 0 1 .717-.098 10.16 10.16 0 0 0 2.837.403c.276 0 .543-.027.811-.05-.857-2.578.157-4.972 1.932-6.446 1.703-1.415 3.882-1.98 5.853-1.838-.576-3.583-4.196-6.348-8.596-6.348zM5.785 5.991c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178A1.17 1.17 0 0 1 4.623 7.17c0-.651.52-1.18 1.162-1.18zm5.813 0c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178 1.17 1.17 0 0 1-1.162-1.178c0-.651.52-1.18 1.162-1.18zm5.34 2.867c-1.797-.052-3.746.512-5.28 1.786-1.72 1.428-2.687 3.72-1.78 6.22.942 2.453 3.666 4.229 6.884 4.229.826 0 1.622-.12 2.361-.336a.722.722 0 0 1 .598.082l1.584.926a.272.272 0 0 0 .14.047c.134 0 .24-.111.24-.247 0-.06-.023-.12-.038-.177l-.327-1.233a.582.582 0 0 1-.023-.156.49.49 0 0 1 .201-.398C23.024 18.48 24 16.82 24 14.98c0-3.21-2.931-5.837-6.656-6.088V8.89c-.135-.01-.27-.027-.407-.032zm-2.53 3.274c.535 0 .969.44.969.982a.976.976 0 0 1-.969.983.976.976 0 0 1-.969-.983c0-.542.434-.982.97-.982zm4.844 0c.535 0 .969.44.969.982a.976.976 0 0 1-.969.983.976.976 0 0 1-.969-.983c0-.542.434-.982.97-.982z"/></svg>
                </a>
              </div>
            </div>
          </div>

          <ContactSection client:visible />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style is:global>
  @import '../styles/global.css';
  @import '../styles/react-components.css';
</style>

<style>
  .contact-wrapper {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    max-width: 1300px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .contact-wrapper {
      grid-template-columns: 0.8fr 1.2fr;
    }
  }

  /* Titre et sous-titre de la section Contact */
  .contact-wrapper-section .section-header h2 {
    color: var(--primary) !important;
    font-size: calc(var(--title-size) * 1.1) !important;
  }

  .contact-wrapper-section .section-subtitle {
    font-weight: 700 !important;
    font-size: 1.15rem !important;
  }

  /* Carte de contact */
  .contact-info-card {
    background: radial-gradient(circle at center, #D4B44A, #C9A227 60%, #A8861E) !important;
    padding: 2.5rem 2rem !important;
    border-radius: var(--border-radius-card) !important;
    box-shadow: var(--shadow-lg) !important;
    border: 1px solid rgba(255, 255, 255, 0.3) !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 1.5rem !important;
    color: #FFFFFF !important;
  }

  /* Texte en gras pour tout le contenu de la carte */
  .contact-card-title,
  .contact-card-row,
  .contact-card-row a,
  .contact-hours span,
  .contact-social-title {
    font-weight: 700 !important;
  }

  /* Titre de la carte */
  .contact-card-title {
    font-size: 1.8rem !important;
    color: #FFFFFF !important;
    margin-bottom: 0.5rem;
  }

  /* Lignes de contact */
  .contact-card-row {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    color: rgba(255, 255, 255, 0.9) !important;
    font-size: 1.1rem !important;
  }

  /* Icônes de lignes agrandies */
  .contact-card-icon {
    width: 28px !important;
    height: 28px !important;
    flex-shrink: 0;
    color: #FFFFFF !important;
    margin-top: 2px;
  }

  .contact-card-row a {
    color: #FFFFFF !important;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .contact-card-row a:hover {
    color: var(--dark) !important;
  }

  .contact-hours {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .contact-hours span {
    color: rgba(255, 255, 255, 0.9) !important;
    font-size: 1rem !important;
  }

  .contact-social-block {
    margin-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.3);
    padding-top: 1.25rem;
  }

  .contact-social-title {
    color: #FFFFFF !important;
    margin-bottom: 0.75rem;
    font-size: 1.1rem !important;
  }

  .contact-social-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* Icônes sociales agrandies et avec rotation */
  .contact-social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px !important;
    height: 56px !important;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2) !important;
    color: #FFFFFF !important;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .contact-social-link:hover {
    background: #FFFFFF !important;
    color: var(--primary) !important;
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .contact-social-link svg {
    width: 28px !important;
    height: 28px !important;
    transition: transform 0.6s ease;
  }

  .contact-social-link:hover svg {
    transform: rotate(360deg);
  }

  /* Responsive */
  @media (max-width: 575px) {
    .contact-info-card {
      padding: 2rem 1.5rem !important;
    }
    .contact-card-title {
      font-size: 1.5rem !important;
    }
    .contact-card-row {
      font-size: 1rem !important;
    }
    .contact-card-icon {
      width: 24px !important;
      height: 24px !important;
    }
    .contact-hours span {
      font-size: 0.95rem !important;
    }
    .contact-social-title {
      font-size: 1rem !important;
    }
    .contact-social-link {
      width: 48px !important;
      height: 48px !important;
    }
    .contact-social-link svg {
      width: 24px !important;
      height: 24px !important;
    }
  }

  /* ===== Section Réalisations : titre doré, sous-titre en gras et polices augmentées ===== */
  .realisations-section .section-header h2 {
    color: var(--primary);
    font-size: calc(var(--title-size) * 1.15);
  }

  .realisations-section .section-subtitle {
    font-weight: 700;
    font-size: 1.2rem;
  }

  /* ===== Formulaire de témoignage (toggle) ===== */
  .testimonial-toggle {
    text-align: center;
    margin-top: 2rem;
  }

  .testimonial-toggle-btn {
    font-weight: 700 !important;
    font-size: 1.1rem !important;
  }

  .testimonial-close-btn {
    margin-top: 1rem;
    font-weight: 600;
  }
</style>