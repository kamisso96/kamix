---
// src/pages/404.astro
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page introuvable - Haikou KAMIX Consulting Co., Ltd."
  description="La page demandée est introuvable."
>
  <main id="main-content" class="not-found-main">
    <div class="not-found-container">
      <h1 class="not-found-code">404</h1>
      <h2 class="not-found-title">Page introuvable</h2>
      <p class="not-found-text">
        Désolé, la page que vous recherchez n'existe pas ou a été déplacée.
      </p>
      <a href="/" class="btn btn-primary not-found-btn">Retour à l'accueil</a>
    </div>
  </main>
</Layout>

<style>
  .not-found-main {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - var(--navbar-height));
    background: var(--white);
    padding: 4rem 1.5rem;
  }

  .not-found-container {
    text-align: center;
    max-width: 600px;
  }

  .not-found-code {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(6rem, 20vw, 12rem);
    color: var(--primary);
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .not-found-title {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--dark);
    margin-bottom: 1rem;
  }

  .not-found-text {
    color: var(--gray);
    font-size: 1.1rem;
    margin-bottom: 2rem;
  }

  .not-found-btn {
    display: inline-block;
    font-weight: 600;
    text-decoration: none;
  }

  @media (max-width: 575px) {
    .not-found-code {
      font-size: 8rem;
    }
  }
</style>
