---
// src/components/HeroSection.astro
---

<section class="hero" id="accueil" role="region" aria-label="Accueil">
  <!-- Diaporama d'arrière-plan -->
  <div class="hero-slideshow" aria-hidden="true">
    <!-- Études -->
    <div class="hero-slide" style="background-image: url('https://images.unsplash.com/photo-1523240795612-9a054b0db644?w=600&q=45&auto=format&fit=crop');"></div>
    <div class="hero-slide" style="background-image: url('https://images.unsplash.com/photo-1541339907198-e08756dedf3f?w=600&q=45&auto=format&fit=crop');"></div>

    <!-- Marchés de Guangzhou / sourcing -->
    <div class="hero-slide" style="background-image: url('https://images.unsplash.com/photo-1553413077-190dd305871c?w=600&q=45&auto=format&fit=crop');"></div>
    <div class="hero-slide" style="background-image: url('https://images.unsplash.com/photo-1561702469-c4239ced3f47?w=600 &q=45&auto=format&fit=crop');"></div>
  </div>

  <!-- Superposition sombre/or pour la lisibilité -->
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="hero-reflection" aria-hidden="true"></div>

  <div class="container hero-content">
    <div class="hero-text">
      <h1 class="hero-title">
        <span class="title-main">HAIKOU KAMIX</span>
        <span class="title-accent">CONSULTING CO., LTD.</span>
      </h1>

      <p class="hero-description">
        Cabinet de conseil international basé à Haikou, facilitant la coopération 
        commerciale, logistique et éducative entre la Chine et le Monde. 
        Votre partenaire de confiance pour réussir à l'international.
      </p>

      <div class="hero-actions">
        <a href="#contact" class="btn btn-hero btn-hero-primary hero-cta">
          Discutons de votre projet
        </a>
        <a href="#services" class="hero-secondary-link">
          Voir nos services
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="hero-scroll-indicator" aria-hidden="true">
    <span class="scroll-dot"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
    margin-top: var(--navbar-height);
    padding: 2rem 0;
  }

  /* Conteneur du diaporama */
  .hero-slideshow {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    animation: heroFade 20s infinite;
  }

  .hero-slide:nth-child(1) { animation-delay: 0s; }
  .hero-slide:nth-child(2) { animation-delay: 5s; }
  .hero-slide:nth-child(3) { animation-delay: 10s; }
  .hero-slide:nth-child(4) { animation-delay: 15s; }

  @keyframes heroFade {
    0% { opacity: 0; }
    5% { opacity: 1; }
    25% { opacity: 1; }
    30% { opacity: 0; }
    100% { opacity: 0; }
  }

  /* ===== FIX #2 : superposition renforcée pour meilleur contraste ===== */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(rgba(0, 0, 0, 0.65), rgba(201, 162, 39, 0.35));
    z-index: 1;
  }

  .hero-overlay::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 40%, rgba(0, 0, 0, 0.7) 100%);
    z-index: 1;
  }

  /* Reflet animé */
  .hero-reflection {
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
    z-index: 2;
    animation: hero-reflect 6s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes hero-reflect {
    0% { left: -60%; }
    50% { left: 100%; }
    100% { left: 100%; }
  }

  .hero-content {
    position: relative;
    z-index: 3;
  }

  .hero-text {
    max-width: 800px;
  }

  .hero-badge {
    display: inline-block;
    background: rgba(201, 162, 39, 0.2);
    color: var(--primary-light);
    padding: 0.5rem 1.5rem;
    border-radius: 50px;
    font-size: 0.85rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-weight: 500;
    backdrop-filter: blur(8px);
    border: 1px solid rgba(201, 162, 39, 0.3);
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1.2;
    letter-spacing: -1px;
    color: var(--white);
    text-shadow: 0 3px 24px rgba(0, 0, 0, 0.75);
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .title-main {
    display: block;
  }

  /* ===== FIX #2 : titre accent sur fond blanc opaque pour contraste AA ===== */
  .title-accent {
    display: inline-block;
    color: #8A6D14;
    background: rgba(255, 255, 255, 0.95);
    padding: 0.25rem 1.5rem;
    border-radius: 50px;
    font-size: clamp(1.5rem, 4vw, 3rem);
    line-height: 1.3;
    letter-spacing: 0;
    width: fit-content;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
  }

  .hero-description {
    color: rgba(255, 255, 255, 0.98);
    font-size: clamp(1.2rem, 1.8vw, 1.5rem);
    max-width: 600px;
    line-height: 1.7;
    margin-bottom: 2.5rem;
    font-weight: 700;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.6);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .hero-cta {
    min-width: 240px;
    font-weight: 700 !important;
    font-size: 1.15rem !important;
  }

  /* ===== FIX #1 : lien secondaire discret au lieu d'un second bouton ===== */
  .hero-secondary-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.95);
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: none;
    padding: 0.5rem 0;
    border-bottom: 2px solid rgba(255, 255, 255, 0.4);
    transition: color 0.3s ease, border-color 0.3s ease, gap 0.3s ease;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
  }

  .hero-secondary-link:hover,
  .hero-secondary-link:focus-visible {
    color: var(--primary-light);
    border-color: var(--primary-light);
    gap: 0.75rem;
  }

  .hero-secondary-link svg {
    transition: transform 0.3s ease;
  }

  .hero-secondary-link:hover svg {
    transform: translateX(3px);
  }

  /* ===== Effet d'extension horizontale depuis le centre ===== */
  .btn-hero {
    position: relative;
    overflow: hidden;
    z-index: 1;
  }

  .btn-hero::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 0;
    background: var(--primary);
    transform: translateX(-50%);
    transition: width 0.5s ease;
    z-index: -1;
  }

  .btn-hero:hover::before,
  .btn-hero:focus-visible::before {
    width: 100%;
  }

  /* Bouton principal : fond blanc, texte doré foncé */
  .btn-hero-primary,
  .btn-hero-primary:visited,
  .btn-hero-primary:active {
    background: var(--white) !important;
    color: #8A6D14 !important;
    border: 2px solid var(--primary) !important;
    text-decoration: none !important;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  }

  .btn-hero-primary:hover,
  .btn-hero-primary:focus-visible {
    color: var(--white) !important;
    border-color: var(--primary) !important;
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }

  .hero-scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .scroll-dot {
    width: 10px;
    height: 10px;
    background: var(--primary);
    border-radius: 50%;
    animation: scroll-pulse 2s ease-in-out infinite;
  }

  @keyframes scroll-pulse {
    0%, 100% { opacity: 0.3; transform: translateY(0); }
    50% { opacity: 1; transform: translateY(8px); }
  }

  /* Responsive */
  @media (min-width: 992px) {
    .hero-text {
      max-width: 66%;
      transform: translateX(-3.5rem);
    }
  }

  @media (max-width: 767px) {
    .hero {
      padding: 1rem 0;
    }
    .hero-title {
      letter-spacing: -0.5px;
    }
    .title-accent {
      font-size: clamp(1.2rem, 5vw, 2rem);
    }
    .hero-actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
    .hero-cta {
      width: 100%;
      text-align: center;
    }
    .hero-scroll-indicator {
      display: none;
    }
  }

  @media (max-width: 575px) {
    .hero-badge {
      font-size: 0.75rem;
      padding: 0.4rem 1rem;
    }
  }

  /* Réduction des animations si préférence utilisateur */
  @media (prefers-reduced-motion: reduce) {
    .hero-reflection {
      display: none;
    }
    .scroll-dot {
      animation: none;
    }
    .hero-slide {
      animation: none;
      opacity: 1;
    }
    .hero-slide:nth-child(1) { opacity: 1; }
    .hero-slide:nth-child(2),
    .hero-slide:nth-child(3),
    .hero-slide:nth-child(4) {
      opacity: 0;
    }
    .btn-hero::before {
      transition: none;
    }
    .btn-hero:hover::before {
      width: 100%;
    }
    .hero-secondary-link {
      transition: none;
    }
  }
</style>
