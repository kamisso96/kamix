<style>
  /* Styles inchangés */
  .floating-social-links {
    position: fixed;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 900;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--white);
    color: var(--primary);
    box-shadow: var(--shadow-md);
    transition: all 0.3s ease;
    position: relative;
    text-decoration: none;
  }

  .social-link:hover,
  .social-link:focus-visible {
    background: var(--primary);
    color: var(--white);
    transform: scale(1.15);
    box-shadow: var(--shadow-lg);
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Tooltip */
  .social-link::after {
    content: attr(data-tooltip);
    position: absolute;
    left: calc(100% + 10px);
    top: 50%;
    transform: translateY(-50%);
    background: var(--dark);
    color: var(--white);
    padding: 0.4rem 0.75rem;
    border-radius: 6px;
    font-size: 0.75rem;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    pointer-events: none;
    font-family: var(--font-body);
  }

  .social-link:hover::after,
  .social-link:focus-visible::after {
    opacity: 1;
    visibility: visible;
  }

  @media (max-width: 767px) {
    .floating-social-links {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .social-link {
      transition: none;
    }
    .social-link:hover,
    .social-link:focus-visible {
      transform: none;
    }
  }
</style>